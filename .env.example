# Enables the single-user dashboard API. Leave this off (or unset) on any
# public deployment: the dashboard has no accounts or authentication yet.
LINKGUARD_DASHBOARD_ENABLED=false

# Optional: where the local SQLite database lives.
# LINKGUARD_DB_PATH=data/linkguard.db

   # Optional: your URLhaus hostfile download link. It contains a private key, so keep it in .env.local only.
   # URLHAUS_HOSTFILE_URL=

   # Dashboard mode: off | server | browser
#   server  = data in this server's SQLite database (your own machine)
#   browser = data in each visitor's own browser; the server only runs scans
# LINKGUARD_DASHBOARD_ENABLED=true is the older switch and means "server".
# LINKGUARD_DASHBOARD_MODE=browser
# Rate limiting needs to know who is calling. If (and only if) ALL traffic reaches
# LinkGuard through ONE trusted proxy that sets a header holding the client's IP,
# name that header here. Cloudflare: cf-connecting-ip.
# If you set this while clients can reach the server directly, they can fake the
# header and dodge the per-client limit. Leave it unset for local use.
# LINKGUARD_CLIENT_IP_HEADER=cf-connecting-ip
# Build-time threat index (when a host builds the index during deployment).
# If "true", the build FAILS when any threat feed is skipped (for example
# because its private URL is not set) instead of deploying with fewer
# sources. Recommended for production hosting.
# THREAT_REQUIRE_ALL_SOURCES=true