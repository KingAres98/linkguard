# Enables the single-user dashboard API. Leave this off (or unset) on any
# public deployment: the dashboard has no accounts or authentication yet.
LINKGUARD_DASHBOARD_ENABLED=false

# Optional: where the local SQLite database lives.
# LINKGUARD_DB_PATH=data/linkguard.db

   # Optional: your URLhaus hostfile download link. It contains a private key, so keep it in .env.local only.
   # URLHAUS_HOSTFILE_URL=

   # Dashboard mode: off | server | browser
#   server  = data in this server's SQLite database (your own machine)
#   browser = data in each visitor's own browser; the server only runs scans
# LINKGUARD_DASHBOARD_ENABLED=true is the older switch and means "server".
# LINKGUARD_DASHBOARD_MODE=browser
LINKGUARD_DASHBOARD_MODE=browser